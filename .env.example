ADMIN_PASSWORD=change-this-password
ADMIN_SESSION_SECRET=generate-a-long-random-secret

# Optional initial contact values. Admin panel values override these.
NEXT_PUBLIC_WHATSAPP_NUMBER=905XXXXXXXXX
NEXT_PUBLIC_PHONE_NUMBER=+905XXXXXXXXX

# Optional server fallback. The admin panel can securely replace this key and model.
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_MODEL=deepseek-v4-flash

# Optional natural voice fallback. The admin panel can securely store these settings.
ELEVENLABS_API_KEY=your-elevenlabs-api-key
ELEVENLABS_VOICE_ID=KAGDtM2gzDrjWlUp2KNe
ELEVENLABS_MODEL=eleven_flash_v2_5

# Vercel Blob (Vercel mağaza bağlantısı otomatik ekler)
BLOB_READ_WRITE_TOKEN=vercel-blob-read-write-token

